-- Plain, single-level USE. Ordinary class-based OO: Car IS-A Vehicle via
-- generalization ("<"). This is the baseline the MLM-USE/ and CatMLM/
-- examples build on -- compare this to MLM-USE/VehicleTaxonomy.use, which
-- models the same domain but replaces "Car IS-A Vehicle" with "a Car
-- INSTANTIATES the category Vehicle" across two separate levels.

model Vehicle

class Vehicle
attributes
  wheels: Integer
operations
  isMultiTrack(): Boolean = self.wheels > 2
end

constraints
context Vehicle inv PositiveWheels:
  self.wheels > 0

class Car < Vehicle
attributes
  seats: Integer
operations
  isFamilyCar(): Boolean = self.seats >= 5
end

constraints
context Car inv ReasonableSeats:
  self.seats > 0 and self.seats <= 9
