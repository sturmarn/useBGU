/*
 * CatMLM front-end for MLM-USE.
 *
 * This grammar parses the "CatMLM" surface syntax (category/clabject
 * shorthand, cat* tags) and builds a parse tree that is *desugared*,
 * in Java (see USECompilerCatUSE.desugar), into the exact same
 * ASTMultiLevelModel/ASTMediator/ASTClabject/ASTModel/ASTClass AST types
 * that the plain MLMUse grammar (USEBase.gpart) already builds. Nothing
 * downstream of that AST (MMultiLevelModel, well-definedness checking,
 * the GUI, ...) needs to know CatMLM exists.
 *
 * Composed as: CatMLM.gpart + USEBase.gpart + OCLBase.gpart +
 * SoilBase.gpart + OCLLexerRules.gpart (see use-core/pom.xml). All
 * type/expression/associationEnd/attributeDefinition-style machinery is
 * reused unmodified from USEBase.gpart/OCLBase.gpart; only the small set
 * of rules that actually differ between MLMUse and CatMLM are defined
 * here.
 */

grammar CatUSE;

options {
  superClass = BaseParser;
}

@header {
package org.tzi.use.parser.catmlm;

import org.tzi.use.parser.base.BaseParser;
import org.tzi.use.parser.use.statemachines.*;
import org.tzi.use.parser.ocl.*;
import org.tzi.use.parser.soil.ast.*;
import org.tzi.use.parser.use.*;
import java.util.Collections;
import java.util.Set;
import java.util.HashSet;
import java.util.List;
import java.util.ArrayList;
import java.util.Iterator;
}

@lexer::header {
package org.tzi.use.parser.catmlm;

import org.tzi.use.parser.ParseErrorHandler;
}

@lexer::members {
    private ParseErrorHandler fParseErrorHandler;

    public String getFilename() {
        return fParseErrorHandler.getFileName();
    }

    @Override
    public String getErrorHeader(RecognitionException e) {
        return "line " + e.line + ":" + e.charPositionInLine;
    }

    public void emitErrorMessage(String msg) {
        fParseErrorHandler.reportError(msg);
    }

    public void init(ParseErrorHandler handler) {
        fParseErrorHandler = handler;
    }
}

/* ------------------------------------------------------------------
   Entry point: same leading keyword as MLMUse ("MLM" name), but a
   sequence of CatMLM-shaped levels instead of separate model/mediator
   sections.
------------------------------------------------------------------ */
catUSE_model returns [ASTCatUSEModel n]
:
    keyMLM mlmName=IDENT { $n = new ASTCatUSEModel(mlmName); }
    ( lvl=catLevel { $n.addLevel($lvl.n); } )+
    ( 'inter-associations'
        ( ia=interAssociationDefinition { $n.addInterAssociation($ia.n); } )*
    )?
    ( 'inter-constraints'
        ( ic=interInvariant { $n.addInterConstraint($ic.n); }
        | ip=interPrePost   { $n.addInterPrePost($ip.n); }
        )*
    )?
    EOF
    ;
    /* interAssociationDefinition, interAssociationEnd, interInvariant, and
       interPrePost are all reused completely unchanged from USEBase.gpart
       (composed into this same CatUSE grammar -- see use-core/pom.xml's
       "Merge CatUSE grammar" step). Mirrors USEBase.gpart's own
       multi_model_core exactly: levels first, required, one-or-more; the
       two inter-* sections after, each optional and at most once, in this
       fixed order, never interleaved with catLevel or repeated. There is
       deliberately no "inter-classes" clause here -- CatMLM does not
       support it (see known-issues.org, Issue 9, for the consequence this
       has for association classes specifically). There is also no
       "catAssociation" alternative inside inter-associations: an
       inter-association carries no cancellation semantics at all, unlike
       its per-level namesake in catAssociationDefinition below. Every
       class reference inside either section must be Model@Class
       (multiType) -- inherited for free from the reused rules and from
       MMultiModel.getClass()'s existing semantic resolution; a bare name
       there is already a hard compile error with no new code needed. */

/* ------------------------------------------------------------------
   "model ID1 [< ID2]" fuses what MLMUse splits across a `model` block
   and a separate `mediator` block. Its body interleaves ordinary
   classifier/association definitions with the new clabject shorthand.

   A classifier declaration may itself carry a ": powerclass-list"
   clause (see catClassifierDefinition) -- Java-"implements"-style
   fusion of instantiation onto the classifier header, as an
   alternative to a separate catClabjectDefinition statement for the
   same name. When present, it is desugared here into exactly the
   same kind of ASTCatClabject a standalone "clabject NAME : ..."
   statement would produce, added to the very same level -- so the
   two spellings are pure syntax sugar for each other, and using both
   for the same class name (e.g. once via the fused header, again via
   a separate clabject statement) is not an error: their powerclass
   lists simply union, the same way two same-level "< ..." clauses
   for one class would.
------------------------------------------------------------------ */
catLevel returns [ASTCatLevel n]
:
    'model' name=IDENT ( '<' parent=IDENT )?
    { $n = new ASTCatLevel(name, parent); }
    (
        c  = catClassifierDefinition       {
            $n.addClassifier($c.n);
            if ($c.powerclasses != null && !$c.powerclasses.isEmpty()) {
                Iterator<Token> it = $c.powerclasses.iterator();
                ASTCatClabject implied = new ASTCatClabject($c.n.getName(), null, it.next());
                while (it.hasNext()) { implied.addPowerclass(it.next()); }
                $n.addClabject(implied);
            }
        }
      | a  = catAssociationDefinition      { $n.addAssociation($a.n); }
      | cl = catClabjectDefinition         { $n.addClabject($cl.n); }
      | ( 'constraints'
          ( inv = catInvariant { $n.addConstraint($inv.n); } )*
        )
    )*
    ;

/* ------------------------------------------------------------------
   "category ID" / "class ID" -- same ASTClass either way; isCategory
   is only a hint consumed by the desugarer (it decides nothing about
   MLMUse semantics by itself).

   Two optional reference-list clauses, mirroring Java's
   "class A extends C implements I1, I2, I3":
     '<' catRefList   -- same-level superclassifiers (as before)
     ':' catRefList   -- NEW: cross-level powerclasses this classifier
                          itself instantiates, fused onto its own
                          header instead of a separate clabject
                          statement (see catLevel above for how the
                          two spellings unify).
   Both use catRefList, not the base grammar's idList: a list of more
   than one name must be parenthesized here, e.g. "< (A, B) : (C, D)",
   purely for readability -- the grammar itself has no ambiguity that
   requires it (":" already unambiguously ends the "<" list on its
   own), but writing two adjacent comma lists side by side in one
   header is hard to scan without a visual boundary. A single name
   stays bare either way: "< A : C".
------------------------------------------------------------------ */
catClassifierDefinition returns [ASTClass n, List<Token> powerclasses]
@init { boolean isCategory = false; }
:
    ( keyCategory { isCategory = true; } | keyClass )
    name=IDENT { $n = new ASTClass(name, false); $n.setIsCategory(isCategory); }
    ( '<' superRefs=catRefList { $n.addSuperClassifiers($superRefs.refs); } )?
    ( COLON powerRefs=catRefList { $powerclasses = $powerRefs.refs; } )?
    ( 'attributes'
        ( a=catAttributeDefinition { $n.addAttribute($a.n); } )*
    )?
    ( 'constraints'
        ( inv=catInvariantClause { $n.addInvariantClause($inv.n); } )*
    )?
    'end'
    ;

/* One bare IDENT, or two-or-more wrapped in parentheses -- see the
   readability note on catClassifierDefinition above. Used for every
   CatMLM class-name reference list: catClassifierDefinition's own
   "<" and ":" clauses, and catClabjectDefinition's ":" powerclass
   list below. */
catRefList returns [List<Token> refs]
@init { $refs = new ArrayList<Token>(); }
:
    single=IDENT { $refs.add(single); }
  | LPAREN first=IDENT { $refs.add(first); }
    ( COMMA next=IDENT { $refs.add(next); } )+
    RPAREN
  ;

/* attr1 : Integer [; catAtt] -- reuses IDENT/COLON/type exactly like
   the base attributeDefinition; only the trailing tag is new. */
catAttributeDefinition returns [ASTAttribute n]
@init { boolean tagged = false; }
:
    name=IDENT COLON t=type { $n = new ASTAttribute(name, $t.n); }
    ( SEMI keyCatAtt { tagged = true; } )?
    SEMI?
    { $n.setCategoryOnly(tagged); }
    ;

/* "inv NAME : [catConstr] expr" -- the cat tag sits between the colon
   and the expression, per the CatMLM worked example. */
catInvariantClause returns [ASTInvariantClause n]
@init { boolean tagged = false; }
:
    'inv' ( name=IDENT )? COLON ( keyCatConstr { tagged = true; } )? e=expression
    { $n = new ASTInvariantClause(name, $e.n); $n.setCategoryOnly(tagged); }
    ;

/* Mirrors the base `invariant` rule (context [id:] type invClause*),
   just calling catInvariantClause instead of the base invariantClause. */
catInvariant returns [ASTConstraintDefinition n]
:
    { $n = new ASTConstraintDefinition(); }
    'context'
    ( v=IDENT { $n.addVarName(v); }
      ( COMMA v=IDENT { $n.addVarName(v); } )* COLON )?
    t=simpleType { $n.setType($t.n); }
    ( inv=catInvariantClause { $n.addInvariantClause($inv.n); } )*
    ;

/* Plain associations, plus the "catAssociation" tag. Reuses the base
   associationEnd rule unchanged. The tag is recorded for future use
   by the desugarer; the first cut passes these associations straight
   through fully inherited, same as an untagged one -- see the
   accompanying writeup for why auto-deriving per-role cancellation
   from this tag alone was left out of this pass. */
catAssociationDefinition returns [ASTAssociation n]
@init { Token t = null; boolean tagged = false; }
:
    { t = input.LT(1); }
    ( keyCatAssociation { tagged = true; } | keyAssociation | keyAggregation | keyComposition )
    name=IDENT { $n = new ASTAssociation(t, name); $n.setCategoryOnly(tagged); }
    'between'
    ae=associationEnd { $n.addEnd($ae.n); }
    ( ae=associationEnd { $n.addEnd($ae.n); } )+
    'end'
    ;

/* ------------------------------------------------------------------
   clabject shorthand:
     clabject C : A, B end
     clabject C : (A, B) end        -- equivalent; parens optional for 2
     clabject E < D; E : B2 end
   One declaration, N powerclasses, optional fused same-level
   subclass edge -- all three collapse to this single rule. No keyword
   precedes the powerclass list: the position after "clabject NAME :"
   unambiguously means "instantiates", just as "clabject NAME <" means
   "same-level subclass of" -- the two relations are already
   distinguished by "<" vs ":", so tagging the right-hand side with
   "category" would be redundant, and it was never checked against the
   target's own declaration anyway. The powerclass list is a
   catRefList (see catClassifierDefinition above), so two or more
   names must be parenthesized, same as everywhere else in CatMLM a
   class-name reference list can appear.
------------------------------------------------------------------ */
catClabjectDefinition returns [ASTCatClabject n]
:
    keyClabject
    ( localName=IDENT '<' localParent=IDENT SEMI )?
    name=IDENT COLON refs=catRefList
    {
        Iterator<Token> it = $refs.refs.iterator();
        $n = new ASTCatClabject(name, localParent, it.next());
        while (it.hasNext()) { $n.addPowerclass(it.next()); }
    }
    'end'
    ;

keyCategory:
  {input.LT(1).getText().equals("category")}? IDENT ;

keyCatAtt:
  {input.LT(1).getText().equals("catAtt")}? IDENT ;

keyCatConstr:
  {input.LT(1).getText().equals("catConstr")}? IDENT ;

keyCatAssociation:
  {input.LT(1).getText().equals("catAssociation")}? IDENT ;
